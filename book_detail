<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi Tiết Sách</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .navbar-placeholder { background-color: #343a40; color: #fff; padding: 15px; text-align: center; margin-bottom: 30px;}
        .rating { font-size: 24px; color: #ffc107; cursor: pointer; }
    </style>
</head>
<body>
    <nav class="navbar-placeholder">Navbar</nav>

    <div class="container mb-5">
        <div class="card shadow-sm p-4">
            <div class="row g-4">
                <!-- Cột trái: Ảnh bìa (chiếm 4/12 phần) -->
                <div class="col-md-4 text-center">
                    <img src="https://via.placeholder.com/300x450.png?text=Bia+Sach" class="img-fluid rounded shadow" alt="Bìa sách">
                </div>

                <!-- Cột phải: Thông tin (chiếm 8/12 phần) -->
                <div class="col-md-8 d-flex flex-column">
                    <h1 class="text-dark">Đắc Nhân Tâm</h1>
                    <h4 class="text-secondary fw-normal mb-3">Tác giả: Dale Carnegie</h4>
                    
                    <div class="mb-4">
                        <span class="badge bg-secondary fs-6 me-2">Công nghệ thông tin</span>
                        <span class="badge bg-light text-dark border fs-6">Tổng: <span id="totalPages">800</span> trang</span>
                    </div>
                    
                    <!-- Khung tiến độ đọc -->
                    <div class="card bg-light border-0 mb-4">
                        <div class="card-body">
                            <strong class="d-block mb-2">Tiến độ đọc:</strong>
                            
                            <!-- Thanh Progress chuẩn Bootstrap -->
                            <div class="progress mb-3" style="height: 25px;">
                                <div id="progressBar" class="progress-bar bg-primary progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%;">0%</div>
                            </div>
                            
                            <div class="d-flex align-items-center gap-2">
                                <span>Đã đọc:</span>
                                <input type="number" id="currentPage" class="form-control w-25" value="0" min="0"> 
                                <span>/ 800 trang</span>
                                <button class="btn btn-primary btn-sm ms-2" onclick="updateProgress()">Cập nhật</button>
                            </div>
                        </div>
                    </div>

                    <!-- Khung đánh giá -->
                    <div class="mb-4">
                        <strong class="d-block mb-2">Đánh giá của bạn:</strong>
                        <div class="rating mb-2">★ ★ ★ ★ ☆</div>
                        <textarea class="form-control" rows="3" placeholder="Nhập cảm nhận của bạn về cuốn sách này..."></textarea>
                    </div>

                    <!-- Nút quay lại -->
                    <div class="mt-auto">
                        <a href="library.html" class="btn btn-secondary">⬅ Quay lại Thư viện</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function updateProgress() {
            const totalPages = parseInt(document.getElementById('totalPages').innerText);
            let currentPage = parseInt(document.getElementById('currentPage').value);

            if (isNaN(currentPage) || currentPage < 0) {
                alert("Số trang không hợp lệ!");
                return;
            }
            if (currentPage > totalPages) {
                alert("Số trang đã đọc không thể lớn hơn tổng số trang!");
                currentPage = totalPages;
                document.getElementById('currentPage').value = totalPages;
            }

            const percentage = Math.round((currentPage / totalPages) * 100);
            
            const progressBar = document.getElementById('progressBar');
            progressBar.style.width = percentage + "%";
            progressBar.innerText = percentage + "%";
        }
    </script>
</body>
</html>
